{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ngenway-cannabis/study.schema.json",
  "title": "Study",
  "type": "object",
  "required": ["id", "citation", "design", "population", "conditions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "citation": {
      "type": "object",
      "required": ["authors", "title", "journal", "year"],
      "properties": {
        "authors": { "type": "string" },
        "title": { "type": "string" },
        "journal": { "type": "string" },
        "year": { "type": "integer" },
        "doi": { "type": "string" },
        "pmid": { "type": "string" },
        "pmcid": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "retrieved": { "type": "string", "format": "date" },
        "retrieval_method": { "type": "string" }
      }
    },
    "design": { "type": "string" },
    "n_enrolled": { "type": "integer" },
    "n_completed": { "type": "integer" },
    "n_analyzed": { "type": "integer" },
    "population": { "type": "string" },
    "conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "statistics_method": { "type": "string" }
  }
}
